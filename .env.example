# =============================================================================
# BNB SMART CHAIN (BSC) CONFIGURATION
# =============================================================================

# BNB Smart Chain Configuration
# Network: 'mainnet' or 'testnet'
NEXT_PUBLIC_BNB_NETWORK=mainnet

# BNB RPC Endpoint
NEXT_PUBLIC_BNB_RPC_ENDPOINT=https://bsc-dataseed.binance.org/

# WalletConnect / Reown Project ID (required for Wagmi + ConnectKit QR / mobile wallets)
# Create a project at https://cloud.reown.com (formerly WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-reown-project-id

# =============================================================================
# PRIVY CONFIGURATION
# =============================================================================

# Privy App ID (from https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Privy App Secret (Backend only - secure this!)
PRIVY_APP_SECRET=your-privy-app-secret

# =============================================================================
# TREASURY CONFIGURATION
# =============================================================================

# BNB Treasury
# Public address where BNB deposits are sent
NEXT_PUBLIC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# BNB Treasury private key (Backend only - secure this!)
BNB_TREASURY_SECRET_KEY=your-bnb-treasury-secret-key

# Sui Treasury secret key (Backend only - secure this!)
# Format: suiprivkey1q...
SUI_TREASURY_SECRET_KEY=your-sui-treasury-secret-key

# Solana Configuration
# -----------------------------------------------------------------------------
# Roles (must stay distinct):
#   • BYNOMO SPL mint — fixed in code as BYNOMO_SPL_MINT_MAINNET (lib/solana/config.ts). Token mint account — NOT a wallet, NOT fee collector.
#   • NEXT_PUBLIC_SOL_TREASURY_ADDRESS — operational house treasury (user SOL/BYNOMO deposits & withdrawals). Pubkey MUST match SOL_TREASURY_SECRET_KEY ONLY.
#   • NEXT_PUBLIC_PLATFORM_FEE_WALLET_BYNOMO — separate Solana address that receives tiered protocol fees (SPL moves treasury → this wallet). Never reuse treasury secret here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# Solana RPC Endpoint (used by the backend and by wallet adapters)
NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOL_TREASURY_ADDRESS=your-solana-treasury-address
# Tiered BYNOMO protocol fees (SPL) route here — must differ from NEXT_PUBLIC_SOL_TREASURY_ADDRESS in production.
NEXT_PUBLIC_PLATFORM_FEE_WALLET_BYNOMO=
# Backend ONLY: secret key for NEXT_PUBLIC_SOL_TREASURY_ADDRESS only (JSON array or base58).
SOL_TREASURY_SECRET_KEY=your-solana-treasury-secret-key
# Dedicated staking vault for BYNOMO staking custody (separate keypair).
NEXT_PUBLIC_SOL_STAKING_VAULT_ADDRESS=
SOL_STAKING_VAULT_SECRET_KEY=

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

NEXT_PUBLIC_APP_NAME=Bynomo
NEXT_PUBLIC_ROUND_DURATION=30
NEXT_PUBLIC_PRICE_UPDATE_INTERVAL=1000
NEXT_PUBLIC_CHART_TIME_WINDOW=300000

# Optional Pyth Hermes key (Starter+). Leave empty to use free Binance/Coinbase/Yahoo feeds.
# Free Pyth Terminal plans have no API access after Aug 2026.
PYTH_API_KEY=
# Optional override; defaults to https://pyth.dourolabs.app/hermes
# PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes

# Pyth Pro / Lazer (server only; do not expose to client). Not a substitute for PYTH_API_KEY.
PYTH_PRO_API_KEY=your-pyth-pro-api-key
# Optional safety switch. Keep false until all feed-symbol mappings are verified.
PYTH_PRO_ENABLE=false
# Optional: fixed_rate@200ms (default), real_time, fixed_rate@1000ms, etc.
PYTH_PRO_CHANNEL=fixed_rate@200ms

# =============================================================================
# SUI NETWORK CONFIGURATION
# =============================================================================

NEXT_PUBLIC_SUI_NETWORK=mainnet
NEXT_PUBLIC_SUI_RPC_ENDPOINT=https://fullnode.mainnet.sui.io:443
NEXT_PUBLIC_SUI_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# USDC Token Type on Sui Mainnet
NEXT_PUBLIC_USDC_TYPE=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC

# =============================================================================
# STELLAR CONFIGURATION
# =============================================================================

NEXT_PUBLIC_STELLAR_NETWORK=public
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon.stellar.org
NEXT_PUBLIC_STELLAR_TREASURY_ADDRESS=your-stellar-treasury-address
# Stellar Treasury secret (Backend only - secure this! Format: S...)
STELLAR_TREASURY_SECRET=your-stellar-treasury-secret

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Backend only; required for admin/server routes)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# =============================================================================
# HOUSE BALANCE API (bet signing + optional request hardening)
# =============================================================================

# HMAC secret used to sign settlement tokens after a bet is placed (server only).
# Required for POST /api/balance/bet. Use a long random string (e.g. openssl rand -hex 32).
BALANCE_SETTLEMENT_SECRET=your-long-random-settlement-secret

# Required in production: long random string (server only — never NEXT_PUBLIC_*).
# The app mints an HttpOnly cookie via POST /api/balance/session; balance mutations accept that cookie
# or Authorization: Bearer <this same secret> for trusted backends/scripts.
BALANCE_INTERNAL_SECRET=your-long-random-balance-internal-secret

# Legacy only (not recommended): if set, first-party browsers may still send x-bynomo-balance-key
# with this value — it is exposed in the client bundle. Prefer removing this and relying on the cookie.
# NEXT_PUBLIC_BALANCE_API_KEY=

# =============================================================================
# TEZOS CONFIGURATION
# =============================================================================

NEXT_PUBLIC_TEZOS_RPC_URL=https://mainnet.ecadinfra.com
# Optional: TzKT API host (must match RPC network). Ghostnet RPC auto-uses api.ghostnet.tzkt.io
# NEXT_PUBLIC_TEZOS_TZKT_API_URL=https://api.tzkt.io
NEXT_PUBLIC_TEZOS_TREASURY_ADDRESS=tz1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Tezos Treasury secret key (Backend only - secure this! Format: edsk...)
TEZOS_TREASURY_SECRET_KEY=your-tezos-treasury-secret-key

# =============================================================================
# NEAR CONFIGURATION
# =============================================================================

NEXT_PUBLIC_NEAR_TREASURY_ADDRESS=your-near-treasury-account-id
NEAR_TREASURY_ACCOUNT_ID=your-near-treasury-account-id
# NEAR Treasury private key (Backend only - secure this! Format: ed25519:...)
NEAR_TREASURY_PRIVATE_KEY=your-near-treasury-private-key
# Optional: RPC URL (must match treasury account network; default mainnet)
# NEAR_NODE_URL=https://rpc.mainnet.near.org
# NEAR_NETWORK_ID=mainnet

# =============================================================================
# PUSH CHAIN CONFIGURATION
# =============================================================================

# Push Chain RPC Endpoint (EVM-compatible, Chain ID: 3400)
NEXT_PUBLIC_PUSH_RPC_ENDPOINT=https://evm.rpc.push.org

# Push Donut block explorer (deposit / withdraw tx links). Default: https://donut.push.network
# NEXT_PUBLIC_PUSH_EXPLORER_URL=https://donut.push.network

# Push Chain Treasury Address
# Can reuse your existing EVM treasury address (same wallet works on all EVM chains)
NEXT_PUBLIC_PUSH_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Push Chain Treasury private key (Backend only - secure this!)
# Can reuse BNB_TREASURY_SECRET_KEY if using the same EVM wallet
PUSH_TREASURY_SECRET_KEY=your-push-treasury-secret-key

# =============================================================================
# STARKNET CONFIGURATION
# =============================================================================

# Target network: mainnet | sepolia | testnet (sepolia = Starknet Sepolia testnet).
# Use sepolia when testing with Argent / Ready Wallet on Sepolia (balances & treasury must match).
NEXT_PUBLIC_STARKNET_NETWORK=mainnet

# Starknet RPC Endpoint (defaults: mainnet lava.build, sepolia blastapi if NETWORK=sepolia)
NEXT_PUBLIC_STARKNET_RPC_URL=https://rpc.starknet.lava.build

# Starknet chain id (SN_MAIN or SN_SEPOLIA — also sets testnet mode if SN_SEPOLIA)
NEXT_PUBLIC_STARKNET_CHAIN_ID=SN_MAIN

# Starknet Treasury address (used by backend withdrawals)
NEXT_PUBLIC_STARKNET_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# STRK token on the configured network (optional; correct defaults are applied per NETWORK)
NEXT_PUBLIC_STARKNET_STRK_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5d4f8b9e98e31f5f17d9d6c17d

# Starknet Treasury private key (Backend only - secure this!)
STARKNET_TREASURY_PRIVATE_KEY=your-starknet-treasury-private-key

# Cairo version: '0' | '1' (defaults to '1' if omitted)
STARKNET_TREASURY_CAIRO_VERSION=1

# =============================================================================
# APTOS CONFIGURATION
# =============================================================================

# Aptos Mainnet Configuration
NEXT_PUBLIC_APTOS_MAINNET_RPC=https://fullnode.mainnet.aptoslabs.com/v1
NEXT_PUBLIC_APTOS_TREASURY_ADDRESS=your-aptos-treasury-address
# Aptos Treasury secret key (Backend only - secure this!)
APTOS_TREASURY_SECRET_KEY=your-aptos-treasury-secret-key

# Platform Fee Collector for Blitz
NEXT_PUBLIC_PLATFORM_FEE_WALLET_APT=your-aptos-fee-collector-address

# =============================================================================
# POSTHOG ANALYTICS CONFIGURATION
# =============================================================================

# PostHog Project API Key (get from https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key

# PostHog API Host
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# MODERATION (optional)
# =============================================================================

# Comma-separated wallet addresses blocked without DB access (EVM addresses lowercased automatically).
# Prefer the `banned_wallets` table + admin dashboard for ongoing moderation.
# BANNED_WALLET_ADDRESSES=0xabc...,Csx2cq3q7GeV79hFUuRR4Pa2T6JUBoC2UjWGbkVqQ4t4

